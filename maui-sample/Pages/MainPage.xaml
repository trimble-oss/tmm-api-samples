<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:Class="MauiSample.MainPage"
  xmlns:local="clr-namespace:MauiSample"
  x:DataType="local:MainPageViewModel">

  <ContentPage.BindingContext>
    <local:MainPageViewModel></local:MainPageViewModel>
  </ContentPage.BindingContext>

  <ScrollView>
    <Grid HorizontalOptions="Center">
      <VerticalStackLayout>

        <VerticalStackLayout>
          <Label
            Text="Application ID"
            Margin="0,0,0,10"/>
          <Entry
            x:Name="AppIDEntry"
            Placeholder="Enter your Application ID"
            Text="{Binding ApplicationID}"
            BackgroundColor="White"
            TextColor="Black"
            WidthRequest="320"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Margin="0,20,0,0" Spacing="12">
          <Button
            x:Name="ConnectButton"
            Text="Connect"
            Command="{Binding ConnectCommand}"
            WidthRequest="120"/>
          <Button
            x:Name="DisconnectButton"
            Text="Disconnect"
            Command="{Binding DisconnectCommand}"
            WidthRequest="120"/>
        </HorizontalStackLayout>

        <Label
          Text="{Binding StatusMessage}"
          Margin="0,20,0,0"/>

        <Grid
          Margin="0,20,0,0"
          ColumnDefinitions="Auto,*"
          RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="12"
          ColumnSpacing="16"
          WidthRequest="320">
          <Label Text="Latitude" Grid.Row="0" Grid.Column="0"/>
          <Label Text="{Binding LatitudeText}" Grid.Row="0" Grid.Column="1"/>
          <Label Text="Longitude" Grid.Row="1" Grid.Column="0"/>
          <Label Text="{Binding LongitudeText}" Grid.Row="1" Grid.Column="1"/>
          <Label Text="Altitude" Grid.Row="2" Grid.Column="0"/>
          <Label Text="{Binding AltitudeText}" Grid.Row="2" Grid.Column="1"/>
          <Label Text="Accuracy" Grid.Row="3" Grid.Column="0"/>
          <Label Text="{Binding AccuracyText}" Grid.Row="3" Grid.Column="1"/>
        </Grid>

      </VerticalStackLayout>
    </Grid>
  </ScrollView>
</ContentPage>
