<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:Class="MauiSample.MainPage"
  xmlns:local="clr-namespace:MauiSample"
  x:DataType="local:MainPageViewModel">

  <ContentPage.BindingContext>
    <local:MainPageViewModel></local:MainPageViewModel>
  </ContentPage.BindingContext>

  <ScrollView>
    <Grid HorizontalOptions="Center" WidthRequest="320">
      <VerticalStackLayout Spacing="20">

        <VerticalStackLayout Spacing="8">
          <Label
            Text="Application ID"
            TextColor="Gray"/>
          <Entry
            x:Name="AppIDEntry"
            Placeholder="Enter your Application ID"
            Text="{Binding ApplicationID}"
            BackgroundColor="White"
            TextColor="Black"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Spacing="12">
          <Button
            x:Name="ConnectButton"
            Text="Connect"
            Command="{Binding ConnectCommand}"/>
          <Button
            x:Name="DisconnectButton"
            Text="Disconnect"
            Command="{Binding DisconnectCommand}"/>
        </HorizontalStackLayout>

        <VerticalStackLayout Spacing="8">
          <Label
            Text="Status"
            TextColor="Gray"/>
          <Label
            Text="{Binding StatusMessage}"/>
        </VerticalStackLayout>

        <Border
          BackgroundColor="DimGray"
          StrokeThickness="0"
          Padding="20">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="8"/>
          </Border.StrokeShape>
          <Grid
            ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto,Auto,Auto"
            RowSpacing="12"
            ColumnSpacing="16">
            <Label Text="Latitude" Grid.Row="0" Grid.Column="0" TextColor="LightGray" FontAttributes="Bold"/>
            <Label Text="{Binding LatitudeText}" Grid.Row="0" Grid.Column="1" TextColor="White" FontAttributes="Bold"/>
            <Label Text="Longitude" Grid.Row="1" Grid.Column="0" TextColor="LightGray" FontAttributes="Bold"/>
            <Label Text="{Binding LongitudeText}" Grid.Row="1" Grid.Column="1" TextColor="White" FontAttributes="Bold"/>
            <Label Text="Altitude" Grid.Row="2" Grid.Column="0" TextColor="LightGray" FontAttributes="Bold"/>
            <Label Text="{Binding AltitudeText}" Grid.Row="2" Grid.Column="1" TextColor="White" FontAttributes="Bold"/>
            <Label Text="Accuracy" Grid.Row="3" Grid.Column="0" TextColor="LightGray" FontAttributes="Bold"/>
            <Label Text="{Binding AccuracyText}" Grid.Row="3" Grid.Column="1" TextColor="White" FontAttributes="Bold"/>
          </Grid>
        </Border>

      </VerticalStackLayout>
    </Grid>
  </ScrollView>
</ContentPage>
