<?xml version="1.0" encoding="utf-8"?>
<ScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  tools:context=".MainActivity">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/application_id_label"
      android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.textfield.TextInputLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp">

      <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/appIdEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_app_id"
        android:inputType="text"
        android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/connectButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:text="@string/connect" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/disconnectButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:enabled="false"
        android:text="@string/disconnect" />
    </LinearLayout>

    <ProgressBar
      android:id="@+id/progressBar"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:indeterminate="true"
      android:visibility="gone" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:text="@string/status_label"
      android:textColor="?android:attr/textColorSecondary" />

    <TextView
      android:id="@+id/statusText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:minHeight="24dp"
      android:textAppearance="?attr/textAppearanceBodyLarge"
      tools:text="Connected." />

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      app:cardBackgroundColor="#696969"
      app:cardCornerRadius="8dp"
      app:cardElevation="0dp">

      <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:padding="20dp"
        android:useDefaultMargins="true">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/latitude"
          android:textColor="#D3D3D3"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/latitudeValue"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_columnWeight="1"
          android:textColor="@android:color/white"
          android:textStyle="bold"
          tools:text="37.12345678°" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/longitude"
          android:textColor="#D3D3D3"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/longitudeValue"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_columnWeight="1"
          android:textColor="@android:color/white"
          android:textStyle="bold"
          tools:text="-122.12345678°" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/altitude"
          android:textColor="#D3D3D3"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/altitudeValue"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_columnWeight="1"
          android:textColor="@android:color/white"
          android:textStyle="bold"
          tools:text="12.345 m" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/accuracy"
          android:textColor="#D3D3D3"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/accuracyValue"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_columnWeight="1"
          android:textColor="@android:color/white"
          android:textStyle="bold"
          tools:text="0.020 m" />
      </GridLayout>
    </com.google.android.material.card.MaterialCardView>

  </LinearLayout>
</ScrollView>
